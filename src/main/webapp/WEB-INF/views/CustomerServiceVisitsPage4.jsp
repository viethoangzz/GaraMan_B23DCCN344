<%@ include file="_header.jspf" %>
<c:url var="backStats" value="/app/reports/customer-revenue"><c:param name="startDate" value="${startDate}"/><c:param name="endDate" value="${endDate}"/><c:param name="paidOnly" value="${paidOnly ? '1' : ''}"/></c:url>
<nav class="crumb"><a href="${pageContext.request.contextPath}/app/dashboard">Trang chủ</a> / <a href="${pageContext.request.contextPath}/app/reports">Report Selection</a> / <a href="${fn:escapeXml(backStats)}">Customer Statistics</a> / Service Visits</nav>
<div class="eyebrow">CUSTOMER STATISTICS · SERVICE VISITS</div><h1>Các lần khách hàng đến sửa xe</h1>
<section class="card"><div class="summary-strip"><div><small>Customer</small><strong><c:out value="${customer.fullName}"/></strong></div><div><small>Date Range</small><strong><c:out value="${startText}"/> — <c:out value="${endText}"/></strong></div><div><small>Customer Revenue</small><strong><fmt:formatNumber value="${revenue}" maxFractionDigits="0"/> VNĐ</strong></div><div><small>Đã thanh toán</small><strong><fmt:formatNumber value="${paidAmount}" maxFractionDigits="0"/> VNĐ</strong></div><div><small>Chưa thanh toán</small><strong><fmt:formatNumber value="${unpaidAmount}" maxFractionDigits="0"/> VNĐ</strong></div></div>
<c:choose><c:when test="${empty visits}"><div class="empty">Khách hàng chưa có Service Visit trong khoảng ngày.</div></c:when><c:otherwise>
<div class="table-scroll"><table><thead><tr><th>TT</th><th>Mã Service Visit</th><th>Ngày đến</th><th>Mã Invoice</th><th class="number">Giá trị Invoice (VNĐ)</th><th>Thanh toán</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="v" items="${visits}" varStatus="st"><tr><td><c:out value="${st.count}"/></td><td><c:out value="${v.visitCode}"/></td><td><c:out value="${v.visitDateText}"/></td>
<td><c:out value="${v.invoiceCode}"/></td><td class="number"><c:if test="${not empty v.invoiceId}"><fmt:formatNumber value="${v.invoiceAmount}" maxFractionDigits="0"/></c:if></td>
<td><c:choose><c:when test="${empty v.invoiceId}">—</c:when><c:when test="${v.paid}"><span class="pill green">Đã thanh toán</span></c:when><c:otherwise><span class="pill orange">Chưa thanh toán</span></c:otherwise></c:choose></td>
<td><c:choose><c:when test="${not empty v.invoiceId}"><c:url var="invUrl" value="/app/reports/invoice"><c:param name="visitId" value="${v.id}"/><c:param name="startDate" value="${startDate}"/><c:param name="endDate" value="${endDate}"/><c:param name="paidOnly" value="${paidOnly ? '1' : ''}"/></c:url><a href="${fn:escapeXml(invUrl)}">View Invoice</a></c:when><c:otherwise>Chưa có Invoice</c:otherwise></c:choose></td></tr></c:forEach>
</tbody></table></div></c:otherwise></c:choose><a class="button light" href="${fn:escapeXml(backStats)}">← Back to Statistics</a></section>
<%@ include file="_footer.jspf" %>
